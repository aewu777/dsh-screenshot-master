{
  "name": "dsh-screenshot-master",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform full-screen and per-window screenshot capture for DeepSeek Harness (Windows 10/11 and macOS 14+). Saves PNG files and returns their absolute paths.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "native/macos/DSHScreenshotHelper.swift",
    "scripts/build-macos-helper.sh",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "screenshot",
    "screen-capture",
    "windows",
    "macos"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "os": [
    "win32",
    "darwin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "build:native:macos": "sh scripts/build-macos-helper.sh",
    "check": "npm run typecheck && npm run lint && npm run build && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.4"
  }
}
